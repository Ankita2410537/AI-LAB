        "# Apply SMOTE\n",
        "smote = SMOTE(random_state=42)\n",
        "\n",
        "X_train_smote, y_train_smote = smote.fit_resample(\n",
        "    X_train,\n",
        "    y_train\n",
        ")\n",
        "\n",
        "# Before SMOTE\n",
        "print(\"=\" * 45)\n",
        "print(\"BEFORE APPLYING SMOTE\")\n",
        "print(\"=\" * 45)\n",
        "\n",
        "print(y_train.value_counts().sort_index())\n",
        "\n",
        "print(\"Total Records Before SMOTE:\", len(y_train))\n",
        "\n",
        "\n",
        "# After SMOTE\n",
        "print(\"\\n\" + \"=\" * 45)\n",
        "print(\"AFTER APPLYING SMOTE\")\n",
        "print(\"=\" * 45)\n",
        "\n",
        "print(y_train_smote.value_counts().sort_index())\n",
        "\n",
        "print(\"Total Records After SMOTE:\", len(y_train_smote))\n",
        "\n",
        "\n",
        "# Check whether the dataset is balanced\n",
        "print(\"\\n\" + \"=\" * 45)\n",
        "\n",
        "if y_train_smote.value_counts().nunique() == 1:\n",
        "    print(\"Class Imbalance Successfully Fixed!\")\n",
        "else:\n",
        "    print(\"Dataset is Not Balanced!\")\n",
        "\n",
        "\n",
        "# Total additional records generated\n",
        "additional_records = len(y_train_smote) - len(y_train)\n",
        "\n",
        "print(\"Additional Records Generated:\", additional_records)"
