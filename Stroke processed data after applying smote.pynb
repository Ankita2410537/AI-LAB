    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import pandas as pd\n",
        "\n",
        "# Calculate class counts\n",
        "before_smote = y_train.value_counts().sort_index()\n",
        "after_smote = y_train_smote.value_counts().sort_index()\n",
        "\n",
        "# Create comparison dataframe\n",
        "comparison_df = pd.DataFrame({\n",
        "    'Class': ['No Stroke (0)', 'Stroke (1)'],\n",
        "    'Before SMOTE': [\n",
        "        before_smote[0],\n",
        "        before_smote[1]\n",
        "    ],\n",
        "    'After SMOTE': [\n",
        "        after_smote[0],\n",
        "        after_smote[1]\n",
        "    ]\n",
        "})\n",
        "\n",
        "# Convert dataframe into graph format\n",
        "graph_df = comparison_df.melt(\n",
        "    id_vars='Class',\n",
        "    var_name='Dataset',\n",
        "    value_name='Number of Records'\n",
        ")\n",
        "\n",
        "# Plot graph\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "ax = sns.barplot(\n",
        "    data=graph_df,\n",
        "    x='Class',\n",
        "    y='Number of Records',\n",
        "    hue='Dataset'\n",
        ")\n",
        "\n",
        "plt.title(\n",
        "    'Class Distribution Before and After SMOTE',\n",
        "    fontsize=16,\n",
        "    fontweight='bold'\n",
        ")\n",
        "\n",
        "plt.xlabel('Stroke Class', fontsize=12)\n",
        "plt.ylabel('Number of Records', fontsize=12)\n",
        "\n",
        "# Display values above bars\n",
        "for container in ax.containers:\n",
        "    ax.bar_label(container, fmt='%d', padding=3)\n",
        "\n",
        "plt.legend(title='Dataset')\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
