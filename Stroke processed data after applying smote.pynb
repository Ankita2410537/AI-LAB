    {
      "cell_type": "code",
      "source": [
        "X = df.drop('stroke', axis=1)\n",
        "\n",
        "y = df['stroke']\n",
        "\n",
        "print(\"Input Features Shape:\", X.shape)\n",
        "\n",
        "print(\"Target Shape:\", y.shape)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "CbOn5y0Zmdcz",
        "outputId": "f96d7812-224d-4eee-d2c5-6d4a684d4eb3"
      },
      "execution_count": 10,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Input Features Shape: (5110, 10)\n",
            "Target Shape: (5110,)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X,\n",
        "    y,\n",
        "    test_size=0.20,\n",
        "    random_state=42,\n",
        "    stratify=y\n",
        ")\n",
        "\n",
        "print(\"Training Data Shape:\", X_train.shape)\n",
        "\n",
        "print(\"Testing Data Shape:\", X_test.shape)\n",
        "\n",
        "print(\"\\nTraining Class Distribution:\")\n",
        "print(y_train.value_counts())\n",
        "\n",
        "print(\"\\nTesting Class Distribution:\")\n",
        "print(y_test.value_counts())"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "vmFrk-P7mjIU",
        "outputId": "3fe4eb14-c142-4a2e-c154-d85e56067bc5"
      },
      "execution_count": 11,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Training Data Shape: (4088, 10)\n",
            "Testing Data Shape: (1022, 10)\n",
            "\n",
            "Training Class Distribution:\n",
            "stroke\n",
            "0    3889\n",
            "1     199\n",
            "Name: count, dtype: int64\n",
            "\n",
            "Testing Class Distribution:\n",
            "stroke\n",
            "0    972\n",
            "1     50\n",
            "Name: count, dtype: int64\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "smote = SMOTE(random_state=42)\n",
        "\n",
        "X_train_smote, y_train_smote = smote.fit_resample(\n",
        "    X_train,\n",
        "    y_train\n",
        ")\n",
        "\n",
        "print(\"Before Applying SMOTE:\")\n",
        "print(y_train.value_counts())\n",
        "\n",
        "print(\"\\nAfter Applying SMOTE:\")\n",
        "print(y_train_smote.value_counts())"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "C8piYC2zmlR_",
        "outputId": "1faa105f-59df-4be7-a6ed-dbef6f61d96a"
      },
      "execution_count": 12,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Before Applying SMOTE:\n",
            "stroke\n",
            "0    3889\n",
            "1     199\n",
            "Name: count, dtype: int64\n",
            "\n",
            "After Applying SMOTE:\n",
            "stroke\n",
            "0    3889\n",
            "1    3889\n",
            "Name: count, dtype: int64\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
        "\n",
        "sns.countplot(x=y_train, ax=axes[0])\n",
        "\n",
        "axes[0].set_title(\"Before SMOTE\")\n",
        "axes[0].set_xlabel(\"Stroke Class\")\n",
        "axes[0].set_ylabel(\"Count\")\n",
        "\n",
        "sns.countplot(x=y_train_smote, ax=axes[1])\n",
        "\n",
        "axes[1].set_title(\"After SMOTE\")\n",
        "axes[1].set_xlabel(\"Stroke Class\")\n",
        "axes[1].set_ylabel(\"Count\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 507
        },
        "id": "cD-7Rj2OmoC-",
        "outputId": "91dbafec-b4f2-4a11-809e-36a296eceb32"
      },
      "execution_count": 13,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1200x500 with 2 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "models = {\n",
        "    \"Logistic Regression\": LogisticRegression(\n",
        "        max_iter=2000,\n",
        "        random_state=42\n",
        "    ),\n",
        "\n",
        "    \"Decision Tree\": DecisionTreeClassifier(\n",
        "        random_state=42\n",
        "    ),\n",
        "\n",
        "    \"Random Forest\": RandomForestClassifier(\n",
        "        n_estimators=200,\n",
        "        random_state=42\n",
        "    ),\n",
        "\n",
        "    \"SVM\": SVC(\n",
        "        probability=True,\n",
        "        random_state=42\n",
        "    ),\n",
        "\n",
        "    \"Gradient Boosting\": GradientBoostingClassifier(\n",
        "        random_state=42\n",
        "    ),\n",
        "\n",
        "    \"ANN\": MLPClassifier(\n",
        "        hidden_layer_sizes=(64, 32),\n",
        "        activation='relu',\n",
        "        solver='adam',\n",
        "        max_iter=500,\n",
        "        early_stopping=True,\n",
        "        random_state=42\n",
        "    )\n",
        "}\n",
        "\n",
        "print(\"All six classification models defined successfully!\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "zBFXzz0Ymwji",
        "outputId": "cfd23807-7727-450c-ee7c-97afdab1317d"
      },
      "execution_count": 14,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "All six classification models defined successfully!\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "results = []\n",
        "\n",
        "confusion_matrices = {}\n",
        "\n",
        "trained_models = {}\n",
        "\n",
        "def evaluate_models(X_train_data, y_train_data, dataset_name):\n",
        "\n",
        "    for name, model in models.items():\n",
        "\n",
        "        clf = clone(model)\n",
        "\n",
        "        print(\"\\nTraining:\", name)\n",
        "\n",
        "        clf.fit(X_train_data, y_train_data)\n",
        "\n",
        "        # Predictions\n",
        "        y_pred = clf.predict(X_test)\n",
        "\n",
        "        # Probability predictions\n",
        "        y_prob = clf.predict_proba(X_test)[:, 1]\n",
        "\n",
        "        # Performance metrics\n",
        "        precision = precision_score(\n",
        "            y_test, y_pred, zero_division=0\n",
        "        )\n",
        "\n",
        "        recall = recall_score(\n",
        "            y_test, y_pred, zero_division=0\n",
        "        )\n",
        "\n",
        "        f1 = f1_score(\n",
        "            y_test, y_pred, zero_division=0\n",
        "        )\n",
        "\n",
        "        accuracy = accuracy_score(\n",
        "            y_test, y_pred\n",
        "        )\n",
        "\n",
        "        auc = roc_auc_score(\n",
        "            y_test, y_prob\n",
        "        )\n",
        "\n",
        "        # Store results\n",
        "        results.append({\n",
        "            \"Dataset\": dataset_name,\n",
        "            \"Model\": name,\n",
        "            \"Precision\": precision,\n",
        "            \"Recall\": recall,\n",
        "            \"F1-Score\": f1,\n",
        "            \"Accuracy\": accuracy,\n",
        "            \"AUC-ROC\": auc\n",
        "        })\n",
        "\n",
        "        # Store confusion matrix\n",
        "        confusion_matrices[\n",
        "            (dataset_name, name)\n",
        "        ] = confusion_matrix(y_test, y_pred)\n",
        "\n",
        "        # Store trained model\n",
        "        trained_models[\n",
        "            (dataset_name, name)\n",
        "        ] = clf\n",
        "\n",
        "        print(\"Precision:\", round(precision, 4))\n",
        "        print(\"Recall:\", round(recall, 4))\n",
        "        print(\"F1-Score:\", round(f1, 4))\n",
        "        print(\"Accuracy:\", round(accuracy, 4))\n",
        "        print(\"AUC-ROC:\", round(auc, 4))\n",
        "\n",
        "        print(\"\\nConfusion Matrix:\")\n",
        "        print(confusion_matrices[(dataset_name, name)])\n",
        "\n",
        "    print(\"\\nCompleted:\", dataset_name)"
      ],
      "metadata": {
        "id": "6aFUl_hxm16R"
      },
      "execution_count": 15,
      "outputs": []
    },
