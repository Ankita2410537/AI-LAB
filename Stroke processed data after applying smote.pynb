    {
      "cell_type": "code",
      "source": [
        "fig, axes = plt.subplots(\n",
        "    2, 6,\n",
        "    figsize=(25, 10)\n",
        ")\n",
        "\n",
        "dataset_names = [\n",
        "    \"Original Imbalanced\",\n",
        "    \"SMOTE Balanced\"\n",
        "]\n",
        "\n",
        "for row, dataset_name in enumerate(dataset_names):\n",
        "\n",
        "    for col, model_name in enumerate(models.keys()):\n",
        "\n",
        "        cm = confusion_matrices[\n",
        "            (dataset_name, model_name)\n",
        "        ]\n",
        "\n",
        "        sns.heatmap(\n",
        "            cm,\n",
        "            annot=True,\n",
        "            fmt='d',\n",
        "            cmap='Blues',\n",
        "            ax=axes[row, col],\n",
        "            cbar=False\n",
        "        )\n",
        "\n",
        "        axes[row, col].set_title(model_name)\n",
        "\n",
        "        axes[row, col].set_xlabel(\"Predicted\")\n",
        "\n",
        "        axes[row, col].set_ylabel(\"Actual\")\n",
        "\n",
        "    axes[row, 0].set_ylabel(\n",
        "        dataset_name + \"\\nActual\"\n",
        "    )\n",
        "\n",
        "plt.suptitle(\n",
        "    \"Confusion Matrices: Original vs SMOTE\",\n",
        "    fontsize=16\n",
        ")\n",
        "\n",
        "plt.tight_layout()\n",
        "\n",
        "plt.show()"
      ],
