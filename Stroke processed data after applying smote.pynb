    {
      "cell_type": "code",
      "source": [
        "metrics = [\n",
        "    'Precision',\n",
        "    'Recall',\n",
        "    'F1-Score',\n",
        "    'Accuracy',\n",
        "    'AUC-ROC'\n",
        "]\n",
        "\n",
        "for metric in metrics:\n",
        "\n",
        "    plt.figure(figsize=(12, 6))\n",
        "\n",
        "    sns.barplot(\n",
        "        data=results_df,\n",
        "        x='Model',\n",
        "        y=metric,\n",
        "        hue='Dataset'\n",
        "    )\n",
        "\n",
        "    plt.title(\n",
        "        'Original vs SMOTE - ' + metric\n",
        "    )\n",
        "\n",
        "    plt.xlabel('Machine Learning Models')\n",
        "    plt.ylabel(metric)\n",
        "\n",
        "    plt.xticks(rotation=30)\n",
        "\n",
        "    plt.tight_layout()\n",
        "\n",
        "    plt.show()"
